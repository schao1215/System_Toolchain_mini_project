# Virtual environment and Python caches. On iCloud-synced folders the
# environment lives in .venv.nosync (iCloud skips it) and .venv is a link to it.
.venv
.venv.nosync/
__pycache__/
*.pyc
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# OS and editor files
.DS_Store
.vscode/
.idea/

# Local copies of submission files. The originals at the root are tracked.
submission/
reports/
* copy.pdf
